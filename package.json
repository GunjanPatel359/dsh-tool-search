{
  "name": "dsh-tool-index",
  "version": "0.1.0",
  "description": "Cut MCP token cost in DSH: send tool definitions as a compact index and load full schemas on demand, with the tool list stable so the prompt cache keeps working. Built on DeepSeek Harness.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./search": "./src/search.mjs"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "tool-index",
    "tool-search",
    "deferred-tools",
    "progressive-disclosure",
    "prompt-cache",
    "token-reduction",
    "agent"
  ],
  "author": "Gunjan Patel",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "vitest": "^5.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GunjanPatel359/dsh-tool-index.git"
  },
  "homepage": "https://github.com/GunjanPatel359/dsh-tool-index#readme",
  "bugs": {
    "url": "https://github.com/GunjanPatel359/dsh-tool-index/issues"
  }
}
